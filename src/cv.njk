---
layout: layouts/base.njk
pageId: cv
title: CV
permalink: /cv/
---
{% import "macros/icons.njk" as icons %}
{% set cv = db.cv %}

<div class="page">
  <div class="term-head"><span class="th-prompt">$</span><span class="th-cmd">cat cv.md</span></div>

  <p class="muted">Both CVs are generated at build time from this site's content
  (homepage + <code>cv.md</code>), so they always stay in sync.</p>

  <div class="cv-download-grid">
    <div class="cv-dl-group">
      <div class="cv-dl-label">English</div>
      <a class="btn" href="/{{ cv.pdf.en }}" download>{{ icons.social("download") }} Download (PDF)</a>
      <a class="btn ghost" href="/{{ cv.pdf.en }}" target="_blank" rel="noopener">{{ icons.social("link") }} Open in new tab</a>
    </div>
    <div class="cv-dl-group">
      <div class="cv-dl-label">中文</div>
      <a class="btn" href="/{{ cv.pdf.zh }}" download>{{ icons.social("download") }} 下載 (PDF)</a>
      <a class="btn ghost" href="/{{ cv.pdf.zh }}" target="_blank" rel="noopener">{{ icons.social("link") }} 開新分頁</a>
    </div>
  </div>
</div>
