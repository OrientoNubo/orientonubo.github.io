{# Popup-able image: .img-thumb is auto-bound to the lightbox by components.js.
   `path` is a content/-relative asset path; it is rewritten + URL-encoded. #}
{% macro thumb(path, alt, cls) -%}
<span class="img-thumb {{ cls | default('') }}">
  <img src="{{ path | assetUrl }}" alt="{{ alt | default('') }}" loading="lazy" decoding="async">
  <span class="img-mask"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg></span>
</span>
{%- endmacro %}
