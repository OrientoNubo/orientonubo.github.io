---
layout: layouts/base.njk
pageId: home
permalink: /
---
{% import "macros/icons.njk" as icons %}
{% import "macros/img.njk" as img %}
{% import "macros/authors.njk" as authors %}
{% set p = db.profile %}
{% set cv = db.cv %}

<div class="shell">
  <aside class="sidebar" id="nubo-sidebar" aria-label="Sections">
    <nav>
      {% for s in site.home.sections %}
      <a href="#sec-{{ s.key }}" data-spy="sec-{{ s.key }}">{{ s.heading }}</a>
      {% endfor %}
    </nav>
  </aside>

  <div class="content">
    {% for s in site.home.sections %}
    <section class="section" id="sec-{{ s.key }}" data-reveal>
      <div class="term-head"><span class="th-prompt">$</span><span class="th-cmd">{{ s.heading }}</span></div>

      {% if s.key == "profile" %}
      <div class="profile-head">
        <div class="profile-id">
          <h1>{{ p.name }}</h1>
          <div class="p-title term-line">{{ p.title }}<span class="term-cursor"></span></div>
          <div class="p-affil">{{ p.affiliation.department }} · <a href="{{ p.affiliation.departmentUrl }}" target="_blank" rel="noopener">{{ p.affiliation.institution }}</a></div>
          <div class="p-affil">Advised by {% for a in p.advisors %}<a href="{{ a.url }}" target="_blank" rel="noopener">{{ a.name }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</div>
          <div class="social-row">
            {% for l in p.socialLinks %}
            <a class="social-link" href="{{ l.url }}"{% if l.icon != 'email' %} target="_blank" rel="noopener"{% endif %}>{{ icons.social(l.icon) }} {{ l.label }}</a>
            {% endfor %}
          </div>
        </div>
        {% if p.profileImage and p.showAvatar %}<img class="profile-avatar" src="{{ p.profileImage | assetUrl }}" alt="{{ p.name }}">{% endif %}
      </div>
      {% if p.about %}<div class="profile-bio">{{ p.about | md | safe }}</div>{% endif %}

      {% elif s.key == "researchInterests" %}
      <div class="interest-row">
        {% for r in p.researchInterests %}<span class="tag">{{ r }}</span>{% endfor %}
      </div>

      {% elif s.key == "education" %}
      <div class="edu-list">
        {% for e in cv.education %}
        <div class="edu-item">
          <div class="ei-row"><span class="ei-degree">{{ e.degree }}</span><span class="ei-period">{{ e.period }}</span></div>
          <div class="ei-school">{{ e.school }}</div>
          {% if e.department %}<div class="ei-dept">{{ e.department }}</div>{% endif %}
          {% if e.detail %}<div class="ei-dept">{{ e.detail }}</div>{% endif %}
          {% if e.gpa %}<div class="ei-dept">{{ e.gpa }}</div>{% endif %}
        </div>
        {% endfor %}
      </div>

      {% elif s.key == "publications" %}
      <div class="pub-list">
        {% for pub in db.publications %}
        <div class="pub-item">
          <div class="pub-title">{{ pub.title }}{% if pub.pinned %} <span class="tag">pinned</span>{% endif %}</div>
          <div class="pub-authors">{{ authors.list(pub.authors) }}</div>
          <div class="pub-venue">{% if pub.status %}{{ pub.status }} {% endif %}{{ pub.venue }}{% if pub.year %} · {{ pub.year }}{% endif %}</div>
          {% if pub.pdf %}<div class="pub-meta-row"><a class="btn sm ghost" href="{{ pub.pdf }}" target="_blank" rel="noopener">{{ icons.social('pdf') }} PDF</a></div>{% endif %}
        </div>
        {% endfor %}
      </div>

      {% elif s.key == "awards" %}
      <div class="gallery-grid">
        {% for aw in db.awards %}
        <div class="gallery-item">
          {% if aw.image %}{{ img.thumb(aw.image, aw.title) }}{% endif %}
          <div class="gi-title">{{ aw.title }}</div>
          <div class="gi-sub">{{ aw.organization }}{% if aw.year %} · {{ aw.year }}{% endif %}</div>
        </div>
        {% endfor %}
      </div>

      {% elif s.key == "certificates" %}
      <div class="gallery-grid">
        {% for ct in db.certificates %}
        <div class="gallery-item">
          {% if ct.image %}{{ img.thumb(ct.image, ct.title) }}{% endif %}
          <div class="gi-title">{{ ct.title }}</div>
          <div class="gi-sub">{{ ct.issuer }}{% if ct.date %} · {{ ct.date }}{% endif %}</div>
        </div>
        {% endfor %}
      </div>

      {% elif s.key == "services" %}
      <div class="cv-entries">
        {% for sv in db.services %}
        <div class="cv-entry">
          <div class="ce-head">{{ sv.role }}</div>
          {% if sv.items | length %}<ul class="ce-list">{% for it in sv.items %}<li>{{ it }}</li>{% endfor %}</ul>{% endif %}
        </div>
        {% endfor %}
      </div>

      {% elif s.key == "experience" %}
      <div class="cv-entries">
        {% for ex in db.experience %}
        <div class="cv-entry">
          <div class="ce-head">{{ ex.role }} · {{ ex.organization }}</div>
          {% if ex.items | length %}
          <ul class="ce-list">
            {% for it in ex.items %}<li>{{ it.en }}{% if it.period %} <span class="ce-period">({{ it.period }})</span>{% endif %}</li>{% endfor %}
          </ul>
          {% endif %}
        </div>
        {% endfor %}
      </div>

      {% elif s.key == "projects" %}
      <div class="pub-list">
        {% for pr in db.projects %}
        <div class="pub-item">
          <div class="pub-title">{{ pr.title }}{% if pr.status %} <span class="tag{% if pr.status == 'active' %} success{% endif %}">{{ pr.status }}</span>{% endif %}</div>
          {% if pr.description %}<div class="pub-abs">{{ pr.description }}</div>{% endif %}
          {% if pr.tags %}<div class="pub-meta-row">{% for t in pr.tags %}<span class="tag neutral">{{ t }}</span>{% endfor %}</div>{% endif %}
          <div class="pub-meta-row">
            {% if pr.github %}<a class="btn sm ghost" href="{{ pr.github }}" target="_blank" rel="noopener">{{ icons.social('github') }} Code</a>{% endif %}
            {% if pr.demo %}<a class="btn sm ghost" href="{{ pr.demo }}" target="_blank" rel="noopener">{{ icons.social('demo') }} Demo</a>{% endif %}
          </div>
        </div>
        {% endfor %}
      </div>
      {% endif %}
    </section>
    {% endfor %}
  </div>
</div>
