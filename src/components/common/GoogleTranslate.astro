---
// Google Translate Component
// Supports: English, Simplified Chinese, Traditional Chinese, Japanese, Korean, German, Arabic, French, Hebrew
---

<div id="google_translate_element" class="gtranslate-wrapper"></div>

<style>
  .gtranslate-wrapper {
    position: fixed;
    bottom: 1rem;
    left: 1rem;
    z-index: 9998;
  }

  /* Hide Google Translate branding and improve styling */
  :global(.goog-te-gadget) {
    font-family: inherit !important;
    font-size: 0 !important;
  }

  :global(.goog-te-gadget .goog-te-combo) {
    padding: 8px 12px;
    font-size: 0.875rem;
    font-family: inherit;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    color: var(--color-text);
    cursor: pointer;
    outline: none;
    transition: all 0.2s;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  :global(.goog-te-gadget .goog-te-combo:hover) {
    border-color: var(--color-primary);
  }

  :global(.goog-te-gadget .goog-te-combo:focus) {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-primary) 20%, transparent);
  }

  /* Hide the "Powered by Google" text */
  :global(.goog-te-gadget > span) {
    display: none !important;
  }

  /* Hide the Google Translate banner */
  :global(.goog-te-banner-frame) {
    display: none !important;
  }

  :global(body) {
    top: 0 !important;
  }

  /* Style for skiptranslate iframe */
  :global(.skiptranslate) {
    display: none !important;
  }

  :global(body.translated-ltr),
  :global(body.translated-rtl) {
    margin-top: 0 !important;
  }
</style>

<script is:inline>
  function googleTranslateElementInit() {
    new google.translate.TranslateElement({
      pageLanguage: 'en',
      includedLanguages: 'en,zh-CN,zh-TW,ja,ko,de,ar,fr,he',
      layout: google.translate.TranslateElement.InlineLayout.SIMPLE,
      autoDisplay: false
    }, 'google_translate_element');
  }
</script>

<script is:inline src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
