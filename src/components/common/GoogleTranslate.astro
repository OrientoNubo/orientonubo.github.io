---
// Google Translate Floating Widget
// Supports: English, Simplified Chinese, Traditional Chinese, Japanese, Korean, German, Arabic, French, Hebrew
---

<div class="gtranslate-floating" id="gtranslate-wrapper">
  <button
    class="gtranslate-toggle"
    id="gtranslate-toggle"
    aria-label="Toggle language selector"
    title="Translate"
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
    </svg>
  </button>
  <div class="gtranslate-dropdown hidden" id="gtranslate-dropdown">
    <div class="gtranslate-header">
      <span class="text-xs font-medium text-[var(--color-text-muted)]">Translate</span>
    </div>
    <div id="google_translate_element"></div>
  </div>
</div>

<style is:global>
  .gtranslate-floating {
    position: fixed;
    top: 80px;
    right: 16px;
    z-index: 40;
  }

  @media (max-width: 768px) {
    .gtranslate-floating {
      top: 72px;
      right: 12px;
    }
  }

  .gtranslate-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    color: var(--color-text);
    cursor: pointer;
    transition: all 0.2s;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .gtranslate-toggle:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    transform: scale(1.05);
  }

  .gtranslate-dropdown {
    position: absolute;
    top: 48px;
    right: 0;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 12px;
    min-width: 140px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
    animation: fadeIn 0.2s ease-out;
  }

  .gtranslate-header {
    margin-bottom: 8px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--color-border);
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Style the Google Translate dropdown */
  .goog-te-gadget {
    font-family: inherit !important;
    font-size: 0 !important;
    line-height: 1 !important;
  }

  .goog-te-gadget .goog-te-combo {
    width: 100%;
    padding: 8px 10px;
    font-size: 0.8rem;
    font-family: inherit;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    color: var(--color-text);
    cursor: pointer;
    outline: none;
    transition: all 0.2s;
  }

  .goog-te-gadget .goog-te-combo:hover {
    border-color: var(--color-primary);
  }

  .goog-te-gadget .goog-te-combo:focus {
    border-color: var(--color-primary);
  }

  /* Hide the "Powered by Google" text */
  .goog-te-gadget > span {
    display: none !important;
  }

  /* Hide the Google Translate banner */
  .goog-te-banner-frame {
    display: none !important;
  }

  body {
    top: 0 !important;
  }

  /* Hide skiptranslate iframe (the banner), but not the dropdown */
  .skiptranslate iframe {
    display: none !important;
  }

  body.translated-ltr,
  body.translated-rtl {
    margin-top: 0 !important;
  }

  /* VT fix for iframe */
  .VIpgJd-ZVi9od-ORHb-OEVmcd {
    display: none !important;
  }
</style>

<script is:inline>
  (function() {
    function initGoogleTranslate() {
      const toggle = document.getElementById('gtranslate-toggle');
      const dropdown = document.getElementById('gtranslate-dropdown');

      if (!toggle || !dropdown) return;

      // Remove old listeners by cloning
      const newToggle = toggle.cloneNode(true);
      toggle.parentNode.replaceChild(newToggle, toggle);

      newToggle.addEventListener('click', function(e) {
        e.stopPropagation();
        dropdown.classList.toggle('hidden');
      });
    }

    // Close dropdown when clicking outside
    document.addEventListener('click', function(e) {
      const wrapper = document.getElementById('gtranslate-wrapper');
      const dropdown = document.getElementById('gtranslate-dropdown');
      if (wrapper && dropdown && !wrapper.contains(e.target)) {
        dropdown.classList.add('hidden');
      }
    });

    // Close dropdown on escape
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        const dropdown = document.getElementById('gtranslate-dropdown');
        if (dropdown) dropdown.classList.add('hidden');
      }
    });

    // Initialize when DOM is ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initGoogleTranslate);
    } else {
      initGoogleTranslate();
    }

    // Reinitialize on View Transitions
    document.addEventListener('astro:page-load', initGoogleTranslate);
  })();
</script>
