---
// Google Translate Component (Navbar version)
// Supports: English, Simplified Chinese, Traditional Chinese, Japanese, Korean, German, Arabic, French, Hebrew
interface Props {
  id?: string;
}
const { id = 'google_translate_element' } = Astro.props;
---

<div id={id} class="gtranslate-nav"></div>

<style is:global>
  .gtranslate-nav {
    display: flex;
    align-items: center;
    height: 32px;
    min-width: 90px;
  }

  /* Style the Google Translate dropdown */
  .goog-te-gadget {
    font-family: inherit !important;
    font-size: 0 !important;
    line-height: 1 !important;
    display: flex !important;
    align-items: center !important;
    height: 32px !important;
  }

  .goog-te-gadget .goog-te-combo {
    padding: 4px 8px;
    font-size: 0.75rem;
    font-family: inherit;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    color: var(--color-text);
    cursor: pointer;
    outline: none;
    transition: all 0.2s;
    min-width: 80px;
    height: 28px;
    line-height: 1;
    vertical-align: middle;
  }

  .goog-te-gadget .goog-te-combo:hover {
    border-color: var(--color-primary);
  }

  .goog-te-gadget .goog-te-combo:focus {
    border-color: var(--color-primary);
  }

  /* Hide the "Powered by Google" text */
  .goog-te-gadget > span {
    display: none !important;
  }

  /* Hide the Google Translate banner */
  .goog-te-banner-frame {
    display: none !important;
  }

  body {
    top: 0 !important;
  }

  /* Hide skiptranslate iframe (the banner), but not the dropdown */
  .skiptranslate iframe {
    display: none !important;
  }

  body.translated-ltr,
  body.translated-rtl {
    margin-top: 0 !important;
  }

  /* VT fix for iframe */
  .VIpgJd-ZVi9od-ORHb-OEVmcd {
    display: none !important;
  }
</style>
