---
// Google Translate Component (Navbar version)
// Supports: English, Simplified Chinese, Traditional Chinese, Japanese, Korean, German, Arabic, French, Hebrew
---

<div id="google_translate_element" class="gtranslate-nav"></div>

<script is:inline>
  function googleTranslateElementInit() {
    new google.translate.TranslateElement({
      pageLanguage: 'en',
      includedLanguages: 'en,zh-CN,zh-TW,ja,ko,de,ar,fr,he',
      layout: google.translate.TranslateElement.InlineLayout.SIMPLE,
      autoDisplay: false
    }, 'google_translate_element');
  }
</script>

<script is:inline src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>

<style is:global>
  .gtranslate-nav {
    display: flex;
    align-items: center;
  }

  /* Style the Google Translate dropdown */
  .goog-te-gadget {
    font-family: inherit !important;
    font-size: 0 !important;
  }

  .goog-te-gadget .goog-te-combo {
    padding: 6px 8px;
    font-size: 0.75rem;
    font-family: inherit;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    color: var(--color-text);
    cursor: pointer;
    outline: none;
    transition: all 0.2s;
    min-width: 80px;
  }

  .goog-te-gadget .goog-te-combo:hover {
    border-color: var(--color-primary);
  }

  .goog-te-gadget .goog-te-combo:focus {
    border-color: var(--color-primary);
  }

  /* Hide the "Powered by Google" text */
  .goog-te-gadget > span {
    display: none !important;
  }

  /* Hide the Google Translate banner */
  .goog-te-banner-frame {
    display: none !important;
  }

  body {
    top: 0 !important;
  }

  /* Hide skiptranslate elements */
  .skiptranslate {
    display: none !important;
  }

  body.translated-ltr,
  body.translated-rtl {
    margin-top: 0 !important;
  }

  /* VT fix for iframe */
  .VIpgJd-ZVi9od-ORHb-OEVmcd {
    display: none !important;
  }
</style>
