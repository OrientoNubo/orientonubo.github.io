---
// Language Bar for Blog Posts
// Displays clickable language buttons that trigger Google Translate
// More stable than the Google Translate dropdown widget
---

<div class="language-bar notranslate" translate="no">
  <div class="language-bar-container">
    <svg class="language-bar-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
    </svg>
    <div class="language-buttons">
      <button class="lang-btn active" data-lang="en">EN</button>
      <button class="lang-btn" data-lang="zh-CN">简中</button>
      <button class="lang-btn" data-lang="zh-TW">繁中</button>
      <button class="lang-btn" data-lang="ja">日本語</button>
      <button class="lang-btn" data-lang="ko">한국어</button>
      <button class="lang-btn" data-lang="fr">Français</button>
      <button class="lang-btn" data-lang="es">Español</button>
      <button class="lang-btn" data-lang="ar">العربية</button>
      <button class="lang-btn" data-lang="de">Deutsch</button>
      <button class="lang-btn" data-lang="ru">Русский</button>
    </div>
  </div>
</div>

<!-- Hidden Google Translate element -->
<div id="google_translate_element" style="display: none;"></div>

<style>
  .language-bar {
    width: 100%;
    margin-top: 1rem;
  }

  .language-bar-container {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 16px;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: 8px;
  }

  .language-bar-icon {
    width: 20px;
    height: 20px;
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  .language-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
  }

  .lang-btn {
    padding: 4px 10px;
    font-size: 0.8rem;
    font-family: inherit;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all 0.2s;
    white-space: nowrap;
  }

  .lang-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .lang-btn.active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: white;
  }
</style>

<style is:global>
  /* Hide the Google Translate banner */
  .goog-te-banner-frame {
    display: none !important;
  }

  body {
    top: 0 !important;
  }

  /* Hide skiptranslate iframe (the banner) */
  .skiptranslate iframe {
    display: none !important;
  }

  body.translated-ltr,
  body.translated-rtl {
    margin-top: 0 !important;
  }

  /* VT fix for iframe */
  .VIpgJd-ZVi9od-ORHb-OEVmcd {
    display: none !important;
  }
</style>

<script>
  function initLanguageBar() {
    const buttons = document.querySelectorAll('.lang-btn');

    // Function to change language via Google Translate
    const changeLanguage = (targetLang: string) => {
      // Update active state immediately
      buttons.forEach(b => b.classList.remove('active'));
      const activeBtn = document.querySelector(`.lang-btn[data-lang="${targetLang}"]`);
      if (activeBtn) activeBtn.classList.add('active');

      if (targetLang === 'en') {
        // Reset to original language - set cookie and reload
        document.cookie = 'googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
        document.cookie = 'googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=' + window.location.hostname;
        // Remove hash and reload
        const cleanUrl = window.location.href.split('#')[0];
        window.location.href = cleanUrl;
      } else {
        // Set cookie for the target language
        const langCookie = `/en/${targetLang}`;
        document.cookie = `googtrans=${langCookie}; path=/;`;
        document.cookie = `googtrans=${langCookie}; path=/; domain=${window.location.hostname}`;

        // Try to use the Google Translate select if available
        const select = document.querySelector('.goog-te-combo') as HTMLSelectElement;
        if (select) {
          select.value = targetLang;
          select.dispatchEvent(new Event('change'));
        } else {
          // If select not available, reload with hash
          window.location.href = window.location.href.split('#')[0] + '#googtrans(en|' + targetLang + ')';
          window.location.reload();
        }
      }
    };

    // Bind click events
    buttons.forEach(btn => {
      // Remove old listeners by cloning
      const newBtn = btn.cloneNode(true);
      btn.parentNode?.replaceChild(newBtn, btn);
    });

    // Re-query and bind fresh
    document.querySelectorAll('.lang-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const targetLang = (btn as HTMLElement).getAttribute('data-lang') || 'en';
        changeLanguage(targetLang);
      });
    });

    // Check current translation state and update active button
    const checkTranslationState = () => {
      const googTransCookie = document.cookie.match(/googtrans=\/en\/([^;]+)/);
      const allBtns = document.querySelectorAll('.lang-btn');

      if (googTransCookie) {
        const currentLang = googTransCookie[1];
        allBtns.forEach(btn => {
          btn.classList.remove('active');
          if (btn.getAttribute('data-lang') === currentLang) {
            btn.classList.add('active');
          }
        });
      } else {
        // Default to EN
        allBtns.forEach(btn => {
          btn.classList.remove('active');
          if (btn.getAttribute('data-lang') === 'en') {
            btn.classList.add('active');
          }
        });
      }
    };

    // Check state after a short delay
    setTimeout(checkTranslationState, 500);
  }

  // Run on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLanguageBar);
  } else {
    initLanguageBar();
  }

  // Re-run on Astro page transitions
  document.addEventListener('astro:page-load', initLanguageBar);
</script>
