---
import { getCollection } from 'astro:content';
import Card from '../common/Card.astro';
import { translations } from '../../i18n/translations';

const publications = await getCollection('publications');
// Sort by pinned first, then by year
const sortedPubs = publications.sort((a, b) => {
  if (a.data.pinned !== b.data.pinned) {
    return a.data.pinned ? -1 : 1;
  }
  return b.data.year - a.data.year;
});
// Display limited number on homepage
const displayPubs = sortedPubs.slice(0, 5);

// Get translations
const t = {
  en: translations.en.publications,
  zh: translations.zh.publications,
};
---

<section id="publications" class="section">
  <div class="container">
    <!-- Section Header -->
    <div class="text-center mb-12">
      <h2 class="text-4xl font-bold font-heading mb-4">
        <span class="text-[var(--color-primary)]">//</span>
        <span class="lang-en">{t.en.title}</span>
        <span class="lang-zh">{t.zh.title}</span>
      </h2>
      <p class="text-[var(--color-text-muted)] max-w-2xl mx-auto">
        <span class="lang-en">{t.en.subtitle}</span>
        <span class="lang-zh">{t.zh.subtitle}</span>
      </p>
    </div>

    <!-- Publications List -->
    <div class="space-y-6">
      {displayPubs.map((pub, index) => (
        <article
          class="pub-card"
          style={`animation-delay: ${index * 0.1}s`}
        >
          <Card class={pub.data.pinned ? 'border-[var(--color-primary)]' : ''}>
            <div class="flex flex-col md:flex-row gap-6">
              <!-- Thumbnail -->
              {pub.data.image && (
                <div class="pub-image w-full md:w-48 h-32 rounded overflow-hidden flex-shrink-0 bg-[var(--color-bg)]">
                  <img
                    src={pub.data.image}
                    alt={pub.data.title}
                    class="w-full h-full object-cover cursor-pointer hover:opacity-80 transition-opacity"
                    loading="lazy"
                    data-lightbox
                  />
                </div>
              )}

              <!-- Content -->
              <div class="flex-1">
                <div class="flex items-start justify-between gap-4 mb-2">
                  <h3 class="text-lg font-bold leading-tight">
                    {pub.data.title}
                  </h3>
                  <div class="flex gap-1 flex-shrink-0">
                    {pub.data.firstAuthor && (
                      <span class="px-2 py-1 text-xs font-bold bg-[var(--color-primary)] text-white rounded">
                        <span class="lang-en">{t.en.firstAuthor}</span>
                        <span class="lang-zh">{t.zh.firstAuthor}</span>
                      </span>
                    )}
                    {pub.data.correspondingAuthor && (
                      <span class="px-2 py-1 text-xs font-bold bg-gray-700 text-white rounded">
                        <span class="lang-en">{t.en.corresponding}</span>
                        <span class="lang-zh">{t.zh.corresponding}</span>
                      </span>
                    )}
                    {pub.data.coAuthor && (
                      <span class="px-2 py-1 text-xs font-bold bg-[var(--color-primary)] text-white rounded">
                        <span class="lang-en">{t.en.coAuthor}</span>
                        <span class="lang-zh">{t.zh.coAuthor}</span>
                      </span>
                    )}
                  </div>
                </div>

                <p class="text-sm text-[var(--color-text-muted)] mb-2 notranslate" translate="no">
                  {pub.data.authors.map((author, i) => (
                    <>
                      {i > 0 && ', '}
                      {author.bold ? <strong class="text-[var(--color-text)]">{author.name}</strong> : author.name}
                    </>
                  ))}
                </p>

                <p class="text-sm mb-4">
                  <span class="font-medium text-[var(--color-primary)]">{pub.data.venue}</span>
                  <span class="text-[var(--color-text-muted)]"> · {pub.data.year}</span>
                </p>

                <!-- Links -->
                <div class="flex flex-wrap gap-2">
                  {pub.data.pdf && (
                    <a href={pub.data.pdf} target="_blank" class="pub-link">
                      {t.en.pdf}
                    </a>
                  )}
                  {pub.data.code && (
                    <a href={pub.data.code} target="_blank" class="pub-link">
                      <span class="lang-en">{t.en.code}</span>
                      <span class="lang-zh">{t.zh.code}</span>
                    </a>
                  )}
                  {pub.data.project && (
                    <a href={pub.data.project} target="_blank" class="pub-link">
                      <span class="lang-en">{t.en.project}</span>
                      <span class="lang-zh">{t.zh.project}</span>
                    </a>
                  )}
                  {pub.data.video && (
                    <a href={pub.data.video} target="_blank" class="pub-link">
                      <span class="lang-en">{t.en.video}</span>
                      <span class="lang-zh">{t.zh.video}</span>
                    </a>
                  )}
                  {pub.data.arxiv && (
                    <a href={pub.data.arxiv} target="_blank" class="pub-link">
                      {t.en.arxiv}
                    </a>
                  )}
                </div>
              </div>
            </div>
          </Card>
        </article>
      ))}
    </div>

    <!-- Empty State -->
    {sortedPubs.length === 0 && (
      <div class="text-center py-12 text-[var(--color-text-muted)]">
        <p>
          <span class="lang-en">{t.en.emptyState}</span>
          <span class="lang-zh">{t.zh.emptyState}</span>
        </p>
      </div>
    )}

    <!-- View All Link -->
    <div class="text-center mt-8">
      <a href="/publications" class="btn btn-outline">
        <span class="lang-en">{t.en.viewAll}</span>
        <span class="lang-zh">{t.zh.viewAll}</span> →
      </a>
    </div>
  </div>
</section>

<style>
  .pub-card {
    animation: fadeInUp 0.5s ease-out both;
  }

  .pub-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 12px;
    font-size: 0.75rem;
    font-weight: 500;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    transition: all 0.2s;
  }

  .pub-link:hover {
    border-color: var(--color-primary);
    background: var(--color-primary);
    color: white;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
