---
import { getEntry } from 'astro:content';
import { translations } from '../../i18n/translations';

const profile = await getEntry('site', 'profile');
if (!profile) {
  throw new Error('Profile not found');
}
const { researchInterests, stats } = profile.data;

// Get translations
const t = {
  en: translations.en.about,
  zhHans: translations['zh-Hans'].about,
  zhHant: translations['zh-Hant'].about,
};
---

<section id="about" class="section">
  <div class="container">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <!-- Content -->
      <div>
        <h2 class="text-4xl font-bold font-heading mb-6">
          <span class="text-[var(--color-primary)]">//</span>
          <span class="lang-en">{t.en.title}</span>
          <span class="lang-zh-Hans">{t.zhHans.title}</span>
          <span class="lang-zh-Hant">{t.zhHant.title}</span>
        </h2>

        <div class="space-y-4 text-[var(--color-text-muted)]">
          <p class="lang-en">{t.en.content}</p>
          <p class="lang-zh-Hans">{t.zhHans.content}</p>
          <p class="lang-zh-Hant">{t.zhHant.content}</p>
        </div>

        <!-- Research Interests -->
        <div class="mt-8">
          <h3 class="text-lg font-bold mb-4">
            <span class="lang-en">{t.en.researchInterests}</span>
            <span class="lang-zh-Hans">{t.zhHans.researchInterests}</span>
            <span class="lang-zh-Hant">{t.zhHant.researchInterests}</span>
          </h3>
          <div class="flex flex-wrap gap-2">
            {researchInterests.map(interest => (
              <span class="px-4 py-2 text-sm font-medium
                           bg-[var(--color-bg-alt)] border border-[var(--color-border)]
                           rounded-full hover:border-[var(--color-primary)]
                           transition-colors">
                {interest}
              </span>
            ))}
          </div>
        </div>
      </div>

      <!-- Stats / Highlights -->
      <div class="grid grid-cols-2 gap-6">
        <div class="stat-card card">
          <div class="card-content text-center">
            <span class="block text-4xl font-bold text-[var(--color-primary)] mb-2">{stats.publications}</span>
            <span class="text-sm text-[var(--color-text-muted)]">
              <span class="lang-en">{t.en.publications}</span>
              <span class="lang-zh-Hans">{t.zhHans.publications}</span>
              <span class="lang-zh-Hant">{t.zhHant.publications}</span>
            </span>
          </div>
        </div>
        <div class="stat-card card">
          <div class="card-content text-center">
            <span class="block text-4xl font-bold text-[var(--color-primary)] mb-2">{stats.reviews}</span>
            <span class="text-sm text-[var(--color-text-muted)]">
              <span class="lang-en">{t.en.reviews}</span>
              <span class="lang-zh-Hans">{t.zhHans.reviews}</span>
              <span class="lang-zh-Hant">{t.zhHant.reviews}</span>
            </span>
          </div>
        </div>
        <div class="stat-card card">
          <div class="card-content text-center">
            <span class="block text-4xl font-bold text-[var(--color-primary)] mb-2">{stats.projects}</span>
            <span class="text-sm text-[var(--color-text-muted)]">
              <span class="lang-en">{t.en.projects}</span>
              <span class="lang-zh-Hans">{t.zhHans.projects}</span>
              <span class="lang-zh-Hant">{t.zhHant.projects}</span>
            </span>
          </div>
        </div>
        <div class="stat-card card">
          <div class="card-content text-center">
            <span class="block text-4xl font-bold text-[var(--color-primary)] mb-2">{stats.awards}</span>
            <span class="text-sm text-[var(--color-text-muted)]">
              <span class="lang-en">{t.en.awards}</span>
              <span class="lang-zh-Hans">{t.zhHans.awards}</span>
              <span class="lang-zh-Hant">{t.zhHant.awards}</span>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .stat-card {
    padding: 32px 24px;
  }
</style>
