---
import { getEntry } from 'astro:content';

const profile = await getEntry('site', 'profile');
if (!profile) {
  throw new Error('Profile not found');
}
const { affiliation, advisors, researchInterests, stats } = profile.data;
---

<section id="about" class="section">
  <div class="container">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <!-- Content -->
      <div>
        <h2 class="text-4xl font-bold font-heading mb-6">
          <span class="text-[var(--color-primary)]">//</span> About Me
        </h2>

        <div class="space-y-4 text-[var(--color-text-muted)]">
          <p>
            I am currently pursuing my Ph.D. at <a href={affiliation.departmentUrl} target="_blank" class="text-[var(--color-primary)] hover:underline">{affiliation.department}</a>,
            <strong class="text-[var(--color-text)]">{affiliation.institution}</strong>,
            advised by Prof. <a href={advisors[0].url} target="_blank" class="text-[var(--color-text)] hover:text-[var(--color-accent)] underline">{advisors[0].name}</a>.
          </p>

          {advisors.length > 1 && (
            <p>
              I also work closely with Prof. <a href={advisors[1].url} target="_blank" class="text-[var(--color-text)] hover:text-[var(--color-accent)] underline">{advisors[1].name}</a>
              at <strong class="text-[var(--color-text)]">{advisors[1].institution}</strong>.
            </p>
          )}

          <p>
            My main research directions include <strong class="text-[var(--color-text)]">{researchInterests.slice(0, 5).join(', ')}</strong>.
            I also explore related areas such as Computer Vision (CV), Machine Learning (ML), Autonomous Vehicles (AV), Human–Computer Interaction (HCI), and Robotics.
          </p>

          <p>
            Please feel free to contact me if you are interested in my research or any of these topics.
          </p>
        </div>

        <!-- Research Interests -->
        <div class="mt-8">
          <h3 class="text-lg font-bold mb-4">Research Interests</h3>
          <div class="flex flex-wrap gap-2">
            {researchInterests.map(interest => (
              <span class="px-4 py-2 text-sm font-medium
                           bg-[var(--color-bg-alt)] border border-[var(--color-border)]
                           rounded-full hover:border-[var(--color-primary)]
                           transition-colors">
                {interest}
              </span>
            ))}
          </div>
        </div>
      </div>

      <!-- Stats / Highlights -->
      <div class="grid grid-cols-2 gap-6">
        <div class="stat-card card">
          <div class="card-content text-center">
            <span class="block text-4xl font-bold text-[var(--color-primary)] mb-2">{stats.publications}</span>
            <span class="text-sm text-[var(--color-text-muted)]">Publications</span>
          </div>
        </div>
        <div class="stat-card card">
          <div class="card-content text-center">
            <span class="block text-4xl font-bold text-[var(--color-primary)] mb-2">{stats.yearsResearch}</span>
            <span class="text-sm text-[var(--color-text-muted)]">Years Research</span>
          </div>
        </div>
        <div class="stat-card card">
          <div class="card-content text-center">
            <span class="block text-4xl font-bold text-[var(--color-primary)] mb-2">{stats.projects}</span>
            <span class="text-sm text-[var(--color-text-muted)]">Projects</span>
          </div>
        </div>
        <div class="stat-card card">
          <div class="card-content text-center">
            <span class="block text-4xl font-bold text-[var(--color-primary)] mb-2">{stats.githubStars}</span>
            <span class="text-sm text-[var(--color-text-muted)]">GitHub Stars</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .stat-card {
    padding: 32px 24px;
  }
</style>
