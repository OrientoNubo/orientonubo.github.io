---
import { getCollection } from 'astro:content';
import Card from '../common/Card.astro';

const projects = await getCollection('projects');
const sortedProjects = projects.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const featuredProjects = sortedProjects.filter(p => p.data.featured);
const displayProjects = featuredProjects.length > 0 ? featuredProjects : sortedProjects.slice(0, 3);
---

<section id="projects" class="section bg-[var(--color-bg-alt)]">
  <div class="container">
    <!-- Section Header -->
    <div class="text-center mb-12">
      <h2 class="text-4xl font-bold font-heading mb-4">
        <span class="text-[var(--color-primary)]">//</span> Projects
      </h2>
      <p class="text-[var(--color-text-muted)] max-w-2xl mx-auto">
        Open-source projects and research implementations.
      </p>
    </div>

    <!-- Projects Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {displayProjects.map((project, index) => (
        <article
          class="project-card"
          style={`animation-delay: ${index * 0.1}s`}
        >
          <Card class="h-full">
            <!-- Image -->
            {project.data.image && (
              <div class="project-image -mx-6 -mt-6 mb-4 h-40 overflow-hidden rounded-t">
                <img
                  src={project.data.image}
                  alt={project.data.title}
                  class="w-full h-full object-cover cursor-pointer hover:opacity-80 transition-opacity"
                  loading="lazy"
                  data-lightbox
                />
              </div>
            )}

            <!-- Status Badge -->
            <div class="flex items-center gap-2 mb-3">
              <span class:list={[
                'px-2 py-1 text-xs font-medium rounded',
                project.data.status === 'active' && 'bg-green-500/20 text-green-400',
                project.data.status === 'completed' && 'bg-blue-500/20 text-blue-400',
                project.data.status === 'archived' && 'bg-gray-500/20 text-gray-400',
              ]}>
                {project.data.status}
              </span>
              {project.data.featured && (
                <span class="px-2 py-1 text-xs font-medium bg-[var(--color-primary)] text-white rounded">
                  Featured
                </span>
              )}
            </div>

            <!-- Title -->
            <h3 class="text-xl font-bold mb-2">
              {project.data.title}
            </h3>

            <!-- Description -->
            <p class="text-sm text-[var(--color-text-muted)] mb-4 line-clamp-3 whitespace-pre-line">
              {project.data.description}
            </p>

            <!-- Tags -->
            <div class="flex flex-wrap gap-2 mb-4">
              {project.data.tags.slice(0, 3).map(tag => (
                <span class="px-2 py-1 text-xs bg-[var(--color-bg)] border border-[var(--color-border)] rounded">
                  {tag}
                </span>
              ))}
            </div>

            <!-- Links -->
            <div class="flex gap-3 mt-auto">
              {project.data.github && (
                <a href={project.data.github} target="_blank" class="project-link">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
                  </svg>
                  GitHub
                </a>
              )}
              {project.data.demo && (
                <a href={project.data.demo} target="_blank" class="project-link">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                  </svg>
                  Demo
                </a>
              )}
            </div>
          </Card>
        </article>
      ))}
    </div>

    <!-- Empty State -->
    {displayProjects.length === 0 && (
      <div class="text-center py-12 text-[var(--color-text-muted)]">
        <p>No projects yet. Check back soon!</p>
      </div>
    )}

    <!-- View All Link -->
    <div class="text-center mt-8">
      <a href="/projects" class="btn btn-outline">
        View All Projects →
      </a>
    </div>
  </div>
</section>

<style>
  .project-card {
    animation: fadeInUp 0.5s ease-out both;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-muted);
    transition: color 0.2s;
  }

  .project-link:hover {
    color: var(--color-primary);
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
