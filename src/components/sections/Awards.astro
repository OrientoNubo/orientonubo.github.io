---
import { getEntry } from 'astro:content';
import Card from '../common/Card.astro';

const profile = await getEntry('site', 'profile');
if (!profile) {
  throw new Error('Profile not found');
}
const { awards } = profile.data;
const displayAwards = awards?.slice(0, 4) ?? [];
---

{awards && awards.length > 0 && (
  <section id="awards" class="section bg-[var(--color-bg-alt)]">
    <div class="container">
      <!-- Section Header -->
      <div class="text-center mb-12">
        <h2 class="text-4xl font-bold font-heading mb-4">
          <span class="text-[var(--color-primary)]">//</span> Awards
        </h2>
        <p class="text-[var(--color-text-muted)] max-w-2xl mx-auto">
          Honors and recognition for research contributions.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        {displayAwards.map((award, index) => (
          <Card class="award-card h-full" style={`animation-delay: ${index * 0.1}s`}>
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-12 h-12 rounded-full bg-[var(--color-primary)] flex items-center justify-center">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-bold mb-1">{award.title}</h3>
                <p class="text-[var(--color-primary)] font-medium text-sm">
                  {award.organization}
                </p>
                <p class="text-[var(--color-text-muted)] text-sm">
                  {award.year}
                </p>
                {award.description && (
                  <p class="text-[var(--color-text-muted)] text-sm mt-2">
                    {award.description}
                  </p>
                )}
              </div>
            </div>
          </Card>
        ))}
      </div>

      <!-- View All Link -->
      <div class="text-center mt-8">
        <a href="/awards" class="btn btn-outline">
          View All Awards →
        </a>
      </div>
    </div>
  </section>
)}

<style>
  .award-card {
    animation: fadeInUp 0.5s ease-out both;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
