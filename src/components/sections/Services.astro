---
import { getCollection } from 'astro:content';
import Card from '../common/Card.astro';

const services = await getCollection('services');
const sortedServices = services.sort((a, b) => a.data.order - b.data.order);
const displayServices = sortedServices.slice(0, 3);
---

{sortedServices.length > 0 && (
  <section id="services" class="section bg-[var(--color-bg-alt)]">
    <div class="container">
      <!-- Section Header -->
      <div class="text-center mb-12">
        <h2 class="text-4xl font-bold font-heading mb-4">
          <span class="text-[var(--color-primary)]">//</span> Services
        </h2>
        <p class="text-[var(--color-text-muted)] max-w-2xl mx-auto">
          Academic services and community contributions.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {displayServices.map((service, index) => (
          <Card class="service-card h-full" style={`animation-delay: ${index * 0.1}s`}>
            <div class="flex items-start gap-3">
              <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-[var(--color-primary)] flex items-center justify-center">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <h3 class="text-xl font-bold mb-1">{service.data.title}</h3>
                <p class="text-[var(--color-primary)] font-medium text-sm mb-2">
                  {service.data.organization}
                </p>
                {service.data.description && (
                  <p class="text-[var(--color-text-muted)] text-sm whitespace-pre-line">
                    {service.data.description}
                  </p>
                )}
              </div>
              {service.data.image && (
                <div class="flex-shrink-0">
                  <img
                    src={service.data.image}
                    alt={service.data.title}
                    class="w-20 h-20 object-cover rounded-lg cursor-pointer hover:opacity-80 transition-opacity"
                    loading="lazy"
                    data-lightbox
                  />
                </div>
              )}
            </div>
          </Card>
        ))}
      </div>

      <!-- View All Link -->
      <div class="text-center mt-8">
        <a href="/services" class="btn btn-outline">
          View All Services →
        </a>
      </div>
    </div>
  </section>
)}

<style>
  .service-card {
    animation: fadeInUp 0.5s ease-out both;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
