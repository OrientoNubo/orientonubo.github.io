---
import { getCollection } from 'astro:content';
import Card from '../common/Card.astro';

const certificates = await getCollection('certificates');
const sortedCertificates = certificates.sort((a, b) => a.data.order - b.data.order);
const displayCertificates = sortedCertificates.slice(0, 3);
---

{sortedCertificates.length > 0 && (
  <section id="certificates" class="section">
    <div class="container">
      <!-- Section Header -->
      <div class="text-center mb-12">
        <h2 class="text-4xl font-bold font-heading mb-4">
          <span class="text-[var(--color-primary)]">//</span> Certificates
        </h2>
        <p class="text-[var(--color-text-muted)] max-w-2xl mx-auto">
          Professional certifications and completed courses.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {displayCertificates.map((cert, index) => (
          <Card class="cert-card h-full" style={`animation-delay: ${index * 0.1}s`}>
            <div class="flex items-start gap-3">
              <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-[var(--color-bg)] border border-[var(--color-border)] flex items-center justify-center">
                <svg class="w-5 h-5 text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <h3 class="font-bold mb-1">{cert.data.title}</h3>
                <p class="text-[var(--color-text-muted)] text-sm">{cert.data.issuer}</p>
                <p class="text-[var(--color-text-muted)] text-xs mt-1">{cert.data.date}</p>
                {cert.data.url && (
                  <a
                    href={cert.data.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 text-[var(--color-primary)] text-sm mt-2 hover:underline"
                  >
                    View Certificate
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                )}
              </div>
              {cert.data.image && (
                <div class="flex-shrink-0">
                  <img
                    src={cert.data.image}
                    alt={cert.data.title}
                    class="w-20 h-20 object-cover rounded-lg cursor-pointer hover:opacity-80 transition-opacity"
                    loading="lazy"
                    data-lightbox
                  />
                </div>
              )}
            </div>
          </Card>
        ))}
      </div>

      <!-- View All Link -->
      <div class="text-center mt-8">
        <a href="/certificates" class="btn btn-outline">
          View All Certificates →
        </a>
      </div>
    </div>
  </section>
)}

<style>
  .cert-card {
    animation: fadeInUp 0.5s ease-out both;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
