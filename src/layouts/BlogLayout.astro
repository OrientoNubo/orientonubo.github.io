---
import BaseLayout from './BaseLayout.astro';
import LanguageBar from '../components/common/LanguageBar.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, date, tags, image, content_en, content_zh_tw, content_ja, content_ko, content_ar } = post.data;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Determine which languages have content
const availableLanguages: { code: string; label: string; content: string }[] = [];

if (content_en) availableLanguages.push({ code: 'en', label: 'EN', content: content_en });
if (content_zh_tw) availableLanguages.push({ code: 'zh-tw', label: '繁中', content: content_zh_tw });
if (content_ja) availableLanguages.push({ code: 'ja', label: '日本語', content: content_ja });
if (content_ko) availableLanguages.push({ code: 'ko', label: '한국어', content: content_ko });
if (content_ar) availableLanguages.push({ code: 'ar', label: 'العربية', content: content_ar });

// Show language bar if any language content exists (even just one)
const hasLanguageContent = availableLanguages.length > 0;

// Create a map of language content for JSON storage
const languageContentMap: Record<string, string> = {};
availableLanguages.forEach(lang => {
  languageContentMap[lang.code] = lang.content;
});
---

<BaseLayout title={title} description={description} image={image}>
  <article class="pt-24 md:pt-28 pb-16">
    <div class="container max-w-3xl">
      <!-- Post Header -->
      <header class="mb-12">
        <div class="flex flex-wrap gap-2 mb-4">
          {tags.map((tag) => (
            <span class="px-3 py-1 text-xs font-medium uppercase tracking-wider
                         bg-[var(--color-primary)] text-white rounded-full">
              {tag}
            </span>
          ))}
        </div>

        <h1 class="text-4xl md:text-5xl font-bold font-heading mb-4 leading-tight">
          {title}
        </h1>

        <time datetime={date.toISOString()} class="text-[var(--color-text-muted)]">
          {formattedDate}
        </time>

        <!-- Language Selection Bar (only if multiple languages) -->
        {hasLanguageContent && (
          <LanguageBar languages={availableLanguages.map(l => ({ code: l.code, label: l.label }))} />
        )}
      </header>

      <!-- Featured Image -->
      {image && (
        <div class="mb-12 rounded-lg overflow-hidden">
          <img src={image} alt={title} class="w-full h-auto" />
        </div>
      )}

      <!-- Post Content -->
      <div class="prose prose-lg max-w-none blog-content
                  prose-headings:font-heading prose-headings:font-bold
                  prose-a:text-[var(--color-primary)] prose-a:no-underline hover:prose-a:underline">

        {/* If no language content fields, show markdown body */}
        {availableLanguages.length === 0 && (
          <div class="content-body">
            <slot />
          </div>
        )}

        {/* Render each language content */}
        {availableLanguages.map((lang, index) => (
          <div
            class="lang-content"
            data-lang={lang.code}
            style={index === 0 ? '' : 'display: none;'}
          >
            {/* Content will be rendered by JavaScript using marked.js */}
            <div class="markdown-body"></div>
          </div>
        ))}

        {/* Store content in JSON for JavaScript to parse */}
        {hasLanguageContent && (
          <script type="application/json" id="blog-content-data" set:html={JSON.stringify(languageContentMap)} />
        )}
      </div>

      <!-- Back Link -->
      <div class="mt-16 pt-8 border-t border-[var(--color-border)]">
        <a href="/blog" class="btn btn-outline">
          &larr; Back to Blog
        </a>
      </div>
    </div>
  </article>

  <!-- Marked.js for markdown rendering -->
  <script is:inline>
    function initBlogContent() {
      var dataScript = document.getElementById('blog-content-data');
      if (!dataScript) return;

      var contentMap;
      try {
        contentMap = JSON.parse(dataScript.textContent || '{}');
      } catch (e) {
        console.error('Failed to parse blog content data:', e);
        return;
      }

      var langContents = document.querySelectorAll('.lang-content');

      langContents.forEach(function(container) {
        var lang = container.getAttribute('data-lang');
        var content = contentMap[lang];
        var markdownBody = container.querySelector('.markdown-body');

        if (content && markdownBody && typeof marked !== 'undefined') {
          markdownBody.innerHTML = marked.parse(content);
        }
      });
    }

    // Load marked.js and then initialize
    function loadMarkedAndInit() {
      if (typeof marked !== 'undefined') {
        initBlogContent();
        return;
      }

      var script = document.createElement('script');
      script.src = 'https://cdn.jsdelivr.net/npm/marked/marked.min.js';
      script.onload = function() {
        initBlogContent();
      };
      document.head.appendChild(script);
    }

    // Run on page load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', loadMarkedAndInit);
    } else {
      loadMarkedAndInit();
    }

    // Re-run on Astro page transitions
    document.addEventListener('astro:page-load', loadMarkedAndInit);
  </script>
</BaseLayout>

<style>
  /* Theme-specific prose colors */
  .blog-content {
    --tw-prose-body: var(--color-text);
    --tw-prose-headings: var(--color-text);
    --tw-prose-links: var(--color-primary);
    --tw-prose-bold: var(--color-text);
    --tw-prose-code: var(--color-text);
    --tw-prose-quotes: var(--color-text-muted);
    --tw-prose-hr: var(--color-border);
    --tw-prose-bullets: var(--color-text-muted);
    --tw-prose-counters: var(--color-text-muted);
    --tw-prose-pre-bg: var(--color-bg-alt);
    --tw-prose-pre-code: var(--color-text);
  }

  /* Code block base styling */
  .blog-content :global(pre) {
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1rem;
  }

  .blog-content :global(code) {
    padding: 0.125rem 0.5rem;
    border-radius: 0.25rem;
  }

  /* Remove Tailwind Typography backticks */
  .blog-content :global(code::before),
  .blog-content :global(code::after) {
    content: none !important;
  }

  .blog-content :global(pre code) {
    padding: 0;
    background-color: transparent !important;
  }

  /* P5 code blocks - dark bg, light text */
  :global([data-theme="p5"]) .blog-content :global(pre) {
    background-color: #1a1a1a;
    color: #f5f5f5;
  }

  :global([data-theme="p5"]) .blog-content :global(code) {
    color: #000000;
    background-color: #e5e5e5;
  }

  :global([data-theme="p5"]) .blog-content :global(pre code) {
    color: #f5f5f5;
    background-color: transparent !important;
  }

  /* P3 code blocks - dark bg, light text */
  :global([data-theme="p3"]) .blog-content :global(pre) {
    background-color: #1a1a2e;
    color: #f5f5f5;
  }

  :global([data-theme="p3"]) .blog-content :global(code) {
    color: #f5f5f5;
    background-color: rgba(255, 255, 255, 0.1);
  }

  :global([data-theme="p3"]) .blog-content :global(pre code) {
    color: #f5f5f5;
    background-color: transparent !important;
  }

  /* RTL support for Arabic */
  .lang-content[data-lang="ar"] {
    direction: rtl;
    text-align: right;
  }
</style>
