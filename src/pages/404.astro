---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 - Page Not Found">
  <div class="min-h-screen flex items-center justify-center">
    <div class="text-center">
      <!-- 404 Number -->
      <div class="relative inline-block mb-8">
        <span class="text-[150px] md:text-[200px] font-bold font-heading text-[var(--color-primary)] opacity-20">
          404
        </span>
        <span class="absolute inset-0 flex items-center justify-center text-6xl md:text-8xl font-bold font-heading text-[var(--color-primary)]">
          404
        </span>
      </div>

      <!-- Message -->
      <h1 class="text-3xl md:text-4xl font-bold font-heading mb-4">
        Page Not Found
      </h1>
      <p class="text-[var(--color-text-muted)] mb-8 max-w-md mx-auto">
        The page you're looking for doesn't exist or has been moved.
        Let's get you back on track.
      </p>

      <!-- Actions -->
      <div class="flex flex-wrap gap-4 justify-center">
        <a href="/" class="btn">
          Go Home
        </a>
        <button onclick="history.back()" class="btn btn-outline">
          Go Back
        </button>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* P5 Theme specific */
  [data-theme="p5"] .text-\[150px\],
  [data-theme="p5"] .text-\[200px\] {
    text-shadow: 8px 8px 0 var(--color-secondary);
  }

  /* P3 Theme specific */
  [data-theme="p3"] .text-\[150px\],
  [data-theme="p3"] .text-\[200px\] {
    text-shadow: 0 0 40px rgba(0, 187, 250, 0.4);
  }
</style>
