---
import PageLayout from '../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import Card from '../components/common/Card.astro';

const awards = await getCollection('awards');
const sortedAwards = awards.sort((a, b) => a.data.order - b.data.order);
---

<PageLayout
  title="Awards"
  description="Honors and recognition for research contributions."
>
  <div class="grid md:grid-cols-2 gap-6">
    {sortedAwards.map((award, index) => (
      <Card class="h-full award-card" style={`animation-delay: ${index * 0.05}s`}>
        <div class="flex items-start gap-4">
          <div class="flex-shrink-0 w-12 h-12 rounded-full bg-[var(--color-primary)] flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <h2 class="text-xl font-bold mb-1">{award.data.title}</h2>
            <p class="text-[var(--color-primary)] font-medium text-sm">
              {award.data.organization}
            </p>
            <p class="text-[var(--color-text-muted)] text-sm">
              {award.data.year}
            </p>
            {award.data.description && (
              <p class="text-[var(--color-text-muted)] text-sm mt-2 whitespace-pre-line">
                {award.data.description}
              </p>
            )}
          </div>
          {award.data.image && (
            <div class="flex-shrink-0">
              <img
                src={award.data.image}
                alt={award.data.title}
                class="w-20 h-20 object-cover rounded-lg cursor-pointer hover:opacity-80 transition-opacity"
                loading="lazy"
                data-lightbox
              />
            </div>
          )}
        </div>
      </Card>
    ))}
  </div>

  {sortedAwards.length === 0 && (
    <div class="text-center py-12 text-[var(--color-text-muted)]">
      <p>No awards yet. Check back soon!</p>
    </div>
  )}
</PageLayout>

<style>
  .award-card {
    animation: fadeInUp 0.5s ease-out both;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
