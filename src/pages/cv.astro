---
import PageLayout from '../layouts/PageLayout.astro';
import Card from '../components/common/Card.astro';
import { getEntry } from 'astro:content';

const cv = await getEntry('cv', 'cv');
if (!cv) {
  throw new Error('CV content not found');
}
const { education, skills, pdfFile } = cv.data;
---

<PageLayout
  title="Curriculum Vitae"
  description="Academic background, research experience, and skills."
>
  <div class="space-y-12">
    <!-- Download Button -->
    {pdfFile && (
      <div class="flex justify-end">
        <a href={pdfFile} download class="btn btn-primary inline-flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
          </svg>
          Download CV
        </a>
      </div>
    )}

    <!-- Education -->
    <section>
      <h2 class="text-2xl font-bold font-heading mb-6">
        <span class="text-[var(--color-primary)]">//</span> Education
      </h2>
      <div class="space-y-4">
        {education.map(item => (
          <Card>
            <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-2">
              <div>
                <h3 class="text-lg font-bold">{item.degree}</h3>
                <p class="text-[var(--color-primary)] notranslate" translate="no">{item.school}</p>
                <p class="text-sm text-[var(--color-text-muted)] notranslate" translate="no">{item.department}</p>
                {item.description && (
                  <p class="text-sm text-[var(--color-text-muted)] mt-2">{item.description}</p>
                )}
              </div>
              <span class="text-sm text-[var(--color-text-muted)] flex-shrink-0">
                {item.period}
              </span>
            </div>
          </Card>
        ))}
      </div>
    </section>

    <!-- Skills -->
    <section>
      <h2 class="text-2xl font-bold font-heading mb-6">
        <span class="text-[var(--color-primary)]">//</span> Skills
      </h2>
      <div class="grid md:grid-cols-3 gap-6">
        <Card>
          <h3 class="text-lg font-bold mb-4">Programming</h3>
          <div class="flex flex-wrap gap-2">
            {skills.programming.map(skill => (
              <span class="px-3 py-1 text-sm bg-[var(--color-bg)] border border-[var(--color-border)] rounded-full">
                {skill}
              </span>
            ))}
          </div>
        </Card>
        <Card>
          <h3 class="text-lg font-bold mb-4">Research Areas</h3>
          <div class="flex flex-wrap gap-2">
            {skills.research.map(skill => (
              <span class="px-3 py-1 text-sm bg-[var(--color-bg)] border border-[var(--color-border)] rounded-full">
                {skill}
              </span>
            ))}
          </div>
        </Card>
        <Card>
          <h3 class="text-lg font-bold mb-4">Tools</h3>
          <div class="flex flex-wrap gap-2">
            {skills.tools.map(skill => (
              <span class="px-3 py-1 text-sm bg-[var(--color-bg)] border border-[var(--color-border)] rounded-full">
                {skill}
              </span>
            ))}
          </div>
        </Card>
      </div>
    </section>
  </div>
</PageLayout>
